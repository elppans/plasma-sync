#!/usr/bin/env bash
#
# plasma-sync.sh
# Backup/restore "bruto" das configurações do KDE Plasma (Arch Linux)
#
# Uso:
#   ./plasma-sync.sh backup   [destino]   # padrão: ~/plasma-sync
#   ./plasma-sync.sh restore  [origem]    # padrão: ~/plasma-sync
#
# Estratégia:
#   1) Arquivos soltos na RAIZ de ~/.config (não recursivo) que batem com
#      os padrões glob abaixo (*rc, *.conf, *.json) são capturados
#      automaticamente. É o estilo clássico de arquivo de config usado
#      pelo KDE/Qt e por boa parte do ecossistema (dolphinrc, kwinrc,
#      QtProject.conf, kwinoutputconfig.json, etc.), então isso cobre
#      tanto os arquivos já conhecidos quanto novos que surgirem em
#      atualizações futuras do Plasma, sem precisar listar um por um.
#   2) Diretórios ficam numa lista EXPLÍCITA (CONFIG_DIRS), de propósito:
#      copiar ~/.config e ~/.local/share inteiros recursivamente pegaria
#      também perfis de navegador, credenciais de apps não relacionados,
#      caches pesados, etc. Diretório é mais arriscado que arquivo solto,
#      então aqui a curadoria manual continua.

set -euo pipefail

ACTION="${1:-}"
TARGET_DIR="${2:-"$HOME/plasma-sync"}"

# --- Padrões (glob) para arquivos soltos na raiz de ~/.config ---------------
CONFIG_ROOT_PATTERNS=(
    "*rc"
    "*.conf"
    "*.json"
)

# --- Diretórios relevantes ao Plasma (curadoria manual) ---------------------
CONFIG_DIRS=(
    ".config/gtk-3.0"
    ".config/gtk-4.0"
    ".config/Kvantum"
    ".config/latte"
    ".config/autostart"
    ".local/share/plasma"
    ".local/share/plasmashell"
    ".local/share/kwin"
    ".local/share/kxmlgui5"
    ".local/share/color-schemes"
    ".local/share/aurorae"
    ".local/share/plasma_looknfeel"
    ".local/share/konsole"
    ".local/share/icons"
    ".local/share/wallpapers"
    ".local/share/kservices5"
)

# Diretório de aplicativos: aqui NÃO copiamos a pasta inteira (tem entradas
# de todo tipo de app instalado). Filtramos só .desktop com alguma chave
# "X-KDE", que indica arquivo editado/criado via KMenuEdit ou menu do Plasma.
APPLICATIONS_DIR=".local/share/applications"

log() { printf '\033[1;34m[plasma-sync]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[aviso]\033[0m %s\n' "$*"; }

usage() {
    cat <<EOF
Uso:
  $0 backup   [destino]   (padrão: ~/plasma-sync)
  $0 restore  [origem]    (padrão: ~/plasma-sync)
EOF
    exit 1
}

# Lista os arquivos soltos em ~/.config (profundidade 1) que batem com
# algum dos padrões em CONFIG_ROOT_PATTERNS.
find_root_files() {
    local -a find_args=()
    local pattern
    for pattern in "${CONFIG_ROOT_PATTERNS[@]}"; do
        find_args+=(-o -iname "$pattern")
    done
    # remove o "-o" inicial
    find_args=("${find_args[@]:1}")

    find "$HOME/.config" -maxdepth 1 -type f \( "${find_args[@]}" \) -printf '%f\n'
}

# Lista (caminhos absolutos) os .desktop dentro de APPLICATIONS_DIR que
# contêm alguma chave "X-KDE" (customizados via KMenuEdit/menu do Plasma).
find_kde_desktop_files() {
    local base="$HOME/$APPLICATIONS_DIR"
    [[ -d "$base" ]] || return 0
    find "$base" -type f -name '*.desktop' -exec grep -lI "X-KDE" {} \;
}

do_backup() {
    log "Backup das configs do Plasma para: $TARGET_DIR"
    mkdir -p "$TARGET_DIR/.config"

    local count=0
    while IFS= read -r fname; do
        [[ -z "$fname" ]] && continue
        rsync -a "$HOME/.config/$fname" "$TARGET_DIR/.config/"
        count=$((count + 1))
    done < <(find_root_files)
    log "arquivos soltos capturados em .config: $count"

    count=0
    while IFS= read -r fpath; do
        [[ -z "$fpath" ]] && continue
        relpath="${fpath#"$HOME"/}"
        dest_parent="$TARGET_DIR/$(dirname "$relpath")"
        mkdir -p "$dest_parent"
        rsync -a "$fpath" "$dest_parent/"
        count=$((count + 1))
    done < <(find_kde_desktop_files)
    log "arquivos .desktop do Plasma (X-KDE) capturados: $count"

    for item in "${CONFIG_DIRS[@]}"; do
        src="$HOME/$item"
        if [[ -e "$src" ]]; then
            dest_parent="$TARGET_DIR/$(dirname "$item")"
            mkdir -p "$dest_parent"
            rsync -a --delete "$src" "$dest_parent/"
            log "OK: $item"
        else
            warn "não encontrado, pulando: $item"
        fi
    done

    log "Backup concluído em: $TARGET_DIR"
    log "Dica: transforme $TARGET_DIR num repositório git para versionar."
}

do_restore() {
    if [[ ! -d "$TARGET_DIR" ]]; then
        echo "Diretório de origem não encontrado: $TARGET_DIR" >&2
        exit 1
    fi

    log "Restaurando configs do Plasma a partir de: $TARGET_DIR"
    read -r -p "Isso vai SOBRESCREVER arquivos de config atuais. Continuar? [s/N] " resp
    [[ "$resp" =~ ^[sS]$ ]] || { log "Cancelado."; exit 0; }

    if [[ -d "$TARGET_DIR/.config" ]]; then
        mkdir -p "$HOME/.config"
        find "$TARGET_DIR/.config" -maxdepth 1 -type f -print0 |
            while IFS= read -r -d '' f; do
                rsync -a "$f" "$HOME/.config/"
                log "restaurado: .config/$(basename "$f")"
            done
    fi

    if [[ -d "$TARGET_DIR/$APPLICATIONS_DIR" ]]; then
        find "$TARGET_DIR/$APPLICATIONS_DIR" -type f -name '*.desktop' -print0 |
            while IFS= read -r -d '' f; do
                relpath="${f#"$TARGET_DIR"/}"
                dest_parent="$HOME/$(dirname "$relpath")"
                mkdir -p "$dest_parent"
                rsync -a "$f" "$dest_parent/"
                log "restaurado: $relpath"
            done
    fi

    for item in "${CONFIG_DIRS[@]}"; do
        src="$TARGET_DIR/$item"
        if [[ -e "$src" ]]; then
            dest_parent="$HOME/$(dirname "$item")"
            mkdir -p "$dest_parent"
            rsync -a --delete "$src" "$dest_parent/"
            log "restaurado: $item"
        fi
    done

    log "Restore concluído."
    warn "Reinicie a sessão do Plasma (logout/login) para aplicar tudo."
}

case "$ACTION" in
    backup)  do_backup ;;
    restore) do_restore ;;
    *) usage ;;
esac
